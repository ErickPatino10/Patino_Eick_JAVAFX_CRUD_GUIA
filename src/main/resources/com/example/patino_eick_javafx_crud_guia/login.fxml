<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.patino_eick_javafx_crud_guia.LoginController"
      alignment="CENTER"
      spacing="15"
      prefWidth="350" prefHeight="280"
      style="-fx-background-color: #1a1a2e;">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="⚽ Sistema de Jugadores"
           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Usuario:"
           style="-fx-text-fill: #aaaaaa;"/>
    <TextField fx:id="txtUsuario" promptText="usuario"
               style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #0f3460; -fx-border-radius: 4;"/>

    <Label text="Contraseña:"
           style="-fx-text-fill: #aaaaaa;"/>
    <PasswordField fx:id="txtPassword" promptText="contraseña"
                   style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #0f3460; -fx-border-radius: 4;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Ingresar" onAction="#ingresar"
                style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100;"/>
        <Button text="Salir" onAction="#salir"
                style="-fx-background-color: #444; -fx-text-fill: white; -fx-pref-width: 80;"/>
    </HBox>

    <Label text="usuario: admin  |  clave: 1234"
           style="-fx-text-fill: #555555; -fx-font-size: 10px;"/>
</VBox>
